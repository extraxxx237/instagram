INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
ANTHROPIC_API_KEY=your_anthropic_api_key

# Comma-separated hashtags to scrape (without #)
TARGET_HASHTAGS=gardening,garden,plants,homegarden,urbangarden,gardenlife,gardeningtips,plantlover,greenthumb,vegetablegarden

# How many top posts to fetch per hashtag
POSTS_PER_HASHTAG=20

# Times to post each day (HH:MM, comma-separated, 24h format)
POST_TIMES=09:00,18:00

# Max posts per day
MAX_POSTS_PER_DAY=2

# Minimum viral score threshold (posts below this are skipped)
MIN_VIRAL_SCORE=50

# Number of caption variations to generate
CAPTION_VARIATIONS=3
